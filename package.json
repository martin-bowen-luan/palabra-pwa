{
  "name": "palabra-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "import:english": "node scripts/import-english-vocabulary.mjs",
    "test": "vitest run",
